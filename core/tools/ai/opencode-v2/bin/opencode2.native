#!/data/data/com.termux/files/usr/bin/bash
# opencode2 wrapper - run the V2 binary through the termux glibc loader

unset LD_PRELOAD
unset LD_LIBRARY_PATH

export GODEBUG=netdns=cgo
export SSL_CERT_FILE=/data/data/com.termux/files/usr/etc/tls/cert.pem

GLIBC_LOADER="/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1"
GLIBC_LIB="/data/data/com.termux/files/usr/glibc/lib"
TOOL_DATA_DIR="__DATA_DIR__"

if [ ! -f "$GLIBC_LOADER" ] || [ ! -f "$TOOL_DATA_DIR/opencode2" ]; then
  echo "Error: termux-glibc or opencode2 binary not found" >&2
  echo "Run: jax reinstall ai --opencode-v2" >&2
  exit 1
fi

exec "$GLIBC_LOADER" --library-path "$GLIBC_LIB" "$TOOL_DATA_DIR/opencode2" "$@"
